# Server
PORT=3000

# Database - Azure PostgreSQL or Supabase
# Azure format: postgresql://user%40server:password@server.postgres.database.azure.com:5432/postgres?sslmode=require
# URL-encode: @ -> %40, # -> %23
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_hr_dev

# JWT
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# JWKS URL for verifying Clerk session tokens (from Clerk Dashboard > API Keys > Frontend API)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
