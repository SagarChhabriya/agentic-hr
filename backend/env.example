# Server
PORT=3000

# Database - Azure PostgreSQL or Supabase
# Azure format: postgresql://user%40server:password@server.postgres.database.azure.com:5432/postgres?sslmode=require
# URL-encode: @ -> %40, # -> %23
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_hr_dev

# JWT
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars

# CORS - comma-separated origins for your frontend
CORS_ORIGIN=https://hire-base.vercel.app,http://localhost:5173

# Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# JWKS URL for verifying Clerk session tokens (from Clerk Dashboard > API Keys > Frontend API)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Resend (transactional email: interview scheduled, assessment links, status updates)
# Get API key from https://resend.com — then verify your "from" domain in Resend dashboard.
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# LiveKit (tokens for candidate interview rooms; agent uses same keys in agent/.env)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (LLM for assessments, job descriptions, etc.; interview voice agent uses same key)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
