# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Backend API
VITE_API_BASE_URL=https://your-api.azurewebsites.net

# Platform admin (optional): when set, only this email sees "Verify companies" and can call admin company APIs.
# Must match backend ADMIN_OWNER_EMAIL. Leave empty to allow any user with ADMIN role (not recommended in production).
# VITE_ADMIN_OWNER_EMAIL=you@example.com

# Admin self-signup at /register/admin — keep false; provision ADMIN in Clerk instead.
# VITE_ENABLE_ADMIN_SIGNUP=false

# Supabase (for candidate video recording storage — optional)
# If not set, recording upload is silently disabled; interviews still work fine.
# Use the same project you already have. Values are in Supabase → Project Settings → API.
# Also create a Storage bucket named "interview-recordings" and allow anon INSERT uploads.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
